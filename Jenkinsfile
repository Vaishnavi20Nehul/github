pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo '🔨 Building the project...'
                sh 'echo "Build stage running..."'
            }
        }
        stage('Deploy') {
            steps {
                echo '🚀 Deploying the project...'
                sh 'echo "Deploy stage completed successfully!"'
            }
        }
    }
}
